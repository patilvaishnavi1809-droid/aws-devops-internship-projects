<!DOCTYPE html>
<html>
<head><title>Student Registration</title></head>
<body>
  <h2>Student Registration Form</h2>
  <form action="http://{{ app_tier_private_ip | default('APP_TIER_PRIVATE_IP') }}/submit.php" method="POST">
    <label>Name:</label><input type="text" name="name" required><br><br>
    <label>Email:</label><input type="email" name="email" required><br><br>
    <label>Course:</label><input type="text" name="course" required><br><br>
    <button type="submit">Register</button>
  </form>
</body>
</html>
